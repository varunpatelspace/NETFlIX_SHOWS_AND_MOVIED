# =============================================================================
# Netflix Live Content Analytics Platform - Environment Configuration Template
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Database Connection
# -----------------------------------------------------------------------------
# Local Development: sqlite:///data/netflix_live.db
# Docker Container:  sqlite:////app/data/netflix_live.db
# Production PG:     postgresql+psycopg2://user:password@localhost:5432/netflix_db
DATABASE_URL=sqlite:///data/netflix_live.db

# -----------------------------------------------------------------------------
# 2. Data Ingestion & Source Configuration
# -----------------------------------------------------------------------------
# Source Type: 'csv' or 'api'
DATA_SOURCE_TYPE=csv

# Path to primary dataset (Local: data/netflix_titles.csv | Docker: /app/data/netflix_titles.csv)
DATA_SOURCE_PATH=data/netflix_titles.csv

# Ingestion Strategy: 'insert_new_only' (fast, append new) or 'upsert' (refresh existing)
DATA_UPDATE_MODE=insert_new_only

# -----------------------------------------------------------------------------
# 3. Backend API Service
# -----------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000

# Backend URL used by clients
# Local Development: http://127.0.0.1:8000 or http://localhost:8000
# Docker Dashboard:  http://api:8000
API_BASE_URL=http://127.0.0.1:8000

# -----------------------------------------------------------------------------
# 4. Streamlit Dashboard Service
# -----------------------------------------------------------------------------
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8501

# -----------------------------------------------------------------------------
# 5. Automation & Scheduling (APScheduler)
# -----------------------------------------------------------------------------
# Master switch for background job scheduler
ENABLE_SCHEDULER=true

# Schedule interval frequency in seconds (default: 3600 = 1 hour)
UPDATE_FREQUENCY_SECONDS=3600
UPDATE_FREQUENCY=HOURLY

# Enable automated catalog ingestion
AUTO_REFRESH_ENABLED=true

# Enable SHA-256 fingerprint change detection to prevent redundant ETL
SOURCE_CHANGE_DETECTION=true

# -----------------------------------------------------------------------------
# 6. Structured Logging Configuration
# -----------------------------------------------------------------------------
# Log levels: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
